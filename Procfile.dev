# Classic defaults for documentation / direct hivemind use.
# `make dev` generates a runtime Procfile from scripts/dev-ports.env and optional .env.worktree.
API: ./scripts/wait-for-it.sh -s -t 0 localhost:7233 && go tool gow run -tags=credimi_extra main.go serve --http=0.0.0.0:8090
UI: ./scripts/wait-for-it.sh -s -t 0 localhost:8090 && cd webapp && bun i && bun dev
