# Action author configuration. Copy to agents/action-author/.env (gitignored) and fill it in.

# One device per worker. Android: adb serial of the test phone (`adb devices`); its app under
# test gets wiped (`pm clear`).
ACTION_AUTHOR_DEVICE_SERIAL=
# iOS (macOS only): UDID of a shut-down simulator (`xcrun simctl list devices`). The worker never
# boots it: each session clones it, installs the selected app, and every reset or replay runs on
# a fresh clone. Set this instead of ACTION_AUTHOR_DEVICE_SERIAL.
# ACTION_AUTHOR_IOS_SIMULATOR_UDID=

# Selected wallet owner's canonified organization name; both worker and UI must use it.
# TEMPORAL_NAMESPACE=your-org
# Trusted Credimi origin serving the selected APK (defaults to the classic local API).
# ACTION_AUTHOR_CREDIMI_URL=http://localhost:8090

# Model: uncomment one option. If several are enabled, the first one listed here wins.

# Scripted model: no API key, no network (`make action-author.worker FAKE=1`).
# ACTION_AUTHOR_FAKE_MODEL=1

# ChatGPT subscription (local browser OAuth; first run `make action-author.login`).
# ACTION_AUTHOR_CHATGPT=1
# ACTION_AUTHOR_CHATGPT_MODEL=gpt-6.1-sol
# ACTION_AUTHOR_CHATGPT_CREDENTIALS=~/.config/credimi-action-author/chatgpt.json

# Native Claude Messages (workspace-scoped key, automatic prompt caching).
# The api.anthropic.com MODEL_BASE_URL below also selects this native path.
# ACTION_AUTHOR_ANTHROPIC=1
# ACTION_AUTHOR_MODEL_API_KEY=
# ACTION_AUTHOR_MODEL=claude-sonnet-5-5
# Cache lifetime: 5m (default), 1h, or off.
# ACTION_AUTHOR_ANTHROPIC_CACHE_TTL=5m
# Clear stale screen observations above this per-request input threshold; 0 disables.
# ACTION_AUTHOR_ANTHROPIC_CONTEXT_TOKENS=30000

# OpenAI-compatible endpoint, e.g. freellmapi.
# ACTION_AUTHOR_MODEL_BASE_URL=http://localhost:3001/v1
# ACTION_AUTHOR_MODEL_API_KEY=
# ACTION_AUTHOR_MODEL=auto

# Alternative: local Ollama.
# ACTION_AUTHOR_MODEL_BASE_URL=http://localhost:11434/v1
# ACTION_AUTHOR_MODEL=qwen3:14b

# OpenAI API, when no option above is enabled.
# OPENAI_API_KEY=

# Optional budgets per `ask` message.
# ACTION_AUTHOR_TOKEN_BUDGET=600000
# ACTION_AUTHOR_MAX_MODEL_CALLS=80

# Where accepted actions are written (default agents/action-author/out).
# ACTION_AUTHOR_OUT_DIR=
# Local UI port (loopback only).
# ACTION_AUTHOR_UI_PORT=8001
