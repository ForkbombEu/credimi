{
  "agent": "ActionAuthor",
  "source": "credimi_action_author.workflow:ActionAuthorWorkflow",
  "init_data": {
    "data": {
      "$ref": "#/$defs/AuthoringContext"
    },
    "required": true
  },
  "handlers": {
    "ask": {
      "description": "Ask for a wallet action, e.g. \"Write the onboarding action for eu.europa.ec.euidi with\nPIN 123456\". The agent explores the app on the phone, then replays its action twice.",
      "mid_turn": "reject",
      "input": {
        "$ref": "#/$defs/TextMessage"
      },
      "output": {
        "$ref": "#/$defs/TextReply"
      }
    },
    "save_wallet_action": {
      "description": "Replay-compatible legacy save handler; new turns use the Accept/Refuse callback.",
      "mid_turn": "reject",
      "input": {
        "$ref": "#/$defs/SaveActionApproval"
      },
      "output": {
        "$ref": "#/$defs/TextReply"
      }
    }
  },
  "states": {},
  "$defs": {
    "AuthoringContext": {
      "additionalProperties": false,
      "properties": {
        "wallet_version_identifier": {
          "minLength": 1,
          "title": "Wallet Version Identifier",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_collection": {
          "enum": [
            "users",
            "_superusers"
          ],
          "title": "Actor Collection",
          "type": "string"
        },
        "slot": {
          "const": "onboarding",
          "title": "Slot",
          "type": "string"
        },
        "app_id": {
          "default": "",
          "title": "App Id",
          "type": "string"
        }
      },
      "required": [
        "wallet_version_identifier",
        "actor_id",
        "actor_collection",
        "slot"
      ],
      "title": "AuthoringContext",
      "type": "object"
    },
    "SaveActionApproval": {
      "additionalProperties": false,
      "description": "Confirmed internal save input and replay-compatible legacy handler contract.",
      "properties": {
        "name": {
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "confirm": {
          "default": false,
          "title": "Confirm",
          "type": "boolean"
        },
        "replace_action_id": {
          "default": "",
          "title": "Replace Action Id",
          "type": "string"
        },
        "expected_existing_sha256": {
          "default": "",
          "title": "Expected Existing Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "candidate_sha256"
      ],
      "title": "SaveActionApproval",
      "type": "object"
    },
    "TextMessage": {
      "description": "Free-form natural-language text from the user (the input to a plain chat handler).",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextMessage",
      "type": "object"
    },
    "TextReply": {
      "description": "A free-form natural-language reply (the output of a plain chat handler).",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextReply",
      "type": "object"
    }
  }
}
