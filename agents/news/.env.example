# News agent model configuration. Copy to agents/news/.env (gitignored) and uncomment one option.
# Without a model, the worker started by `make dev` idles with a message.

# OpenAI API.
# OPENAI_API_KEY=

# OpenAI-compatible endpoint, e.g. freellmapi.
# NEWS_AGENT_MODEL_BASE_URL=http://localhost:3001/v1
# NEWS_AGENT_MODEL_API_KEY=
# NEWS_AGENT_MODEL=auto:news

# Alternative: local Ollama.
# NEWS_AGENT_MODEL_BASE_URL=http://localhost:11434/v1
# NEWS_AGENT_MODEL=qwen3:14b

# Scripted model: no API key, no network (pair with NEWS_AGENT_FIXTURES_DIR for offline GitHub).
# NEWS_AGENT_FAKE_MODEL=1

# Optional: raises the GitHub API rate limit.
# GITHUB_TOKEN=
