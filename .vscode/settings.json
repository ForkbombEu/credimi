{
    "mise.configureExtensionsAutomatically": false,
    "go.lintTool": "golangci-lint-v2",
    "go.lintFlags": ["--path-mode=abs", "--fast-only"],
    "go.formatTool": "custom",
    "go.formatFlags": ["fmt", "--stdin"],
    "go.alternateTools": {
        "customFormatter": "golangci-lint",
        "golangci-lint-v2": "golangci-lint"
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "never"
        }
    },
    "tailwindCSS.classAttributes": [
        "class",
        "className",
        "contentClass",
        "containerClass",
        "rowCellClass",
        "rowClass",
        "headerClass"
    ],
    "editor.quickSuggestions": {
        "strings": "on"
    },
    "cSpell.words": ["temporalapi"],
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.useEditorConfig": true,
    "prettier.documentSelectors": ["**/*.svelte"],
    "[svelte]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.codeActionsOnSave": [
        "source.organizeImports",
        "source.fixAll.eslint"
    ],
    "eslint.validate": ["javascript", "typescript", "svelte"],
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "i18n-ally.editor.preferEditor": true,
    "i18n-ally.localesPaths": ["webapp/messages"],
    "i18n-ally.enabledFrameworks": ["svelte"],
    "i18n-ally.indent": 4,
    "i18n-ally.tabStyle": "tab"
}
